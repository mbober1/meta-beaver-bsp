/dts-v1/;

#include "rk3506-luckfox-lyra.dtsi"

/ {
	model = "Luckfox Lyra Plus";
	compatible = "rockchip,rk3506g-lyra-plus", "rockchip,rk3506g-demo-display-control", "rockchip,rk3506";

	mcu_rproc: mcu@fff84000 {
		compatible = "rockchip,rk3506-mcu";
		reg = <0xfff84000 0x8000>;
		firmware-name = "rk3506-m0.elf";
		mboxes = <&mailbox3 0>;
		mbox-names = "rpmsg";
		memory-region = <&vdev0vring0>, <&vdev0vring1>, <&vdev0buffer>;

    /* for now include the clocks also that required by the MCU FW */
		clocks = <&cru HCLK_M0>, <&cru STCLK_M0>,
		         <&cru PCLK_TIMER>, <&cru CLK_TIMER0_CH5>,
						 <&cru SCLK_UART4>, <&cru PCLK_UART4>,
						 <&cru CLK_SARADC>, <&cru PCLK_SARADC>;

		resets = <&cru SRST_H_M0>, <&cru SRST_M0_JTAG>, <&cru SRST_HRESETN_M0_AC>;
		reset-names = "h_m0", "m0_jtag", "hresetn_m0_ac";
	};
};

&reserved_memory {
	/* remote amp core address */
	amp_shmem_reserved: amp-shmem@3b00000 {
		reg = <0x03b00000 0x100000>;
    no-map;
	};

	rpmsg_reserved: rpmsg@3c00000 {
		reg = <0x03c00000 0x100000>;
    no-map;
	};

	rpmsg_dma_reserved: rpmsg-dma@3d00000 {
		compatible = "shared-dma-pool";
		reg = <0x03d00000 0x100000>;
    no-map;
	};

  amp_reserved: amp@3e00000 {
		reg = <0x3e00000 0x100000>;
		no-map;
	};

	/* mcu address */
	tee_reserved: tee@fff80000 {
		reg = <0xfff80000 0x1000>;
		no-map;
	};

	vdev0vring0: vdev0vring0@fff81000 {
		reg = <0xfff81000 0x1000>;
		no-map;
	};

	vdev0vring1: vdev0vring1@fff82000 {
		reg = <0xfff82000 0x1000>;
		no-map;
	};

	vdev0buffer: vdev0buffer@fff83000 {
		compatible = "shared-dma-pool";
		reg = <0xfff83000 0x1000>;
		no-map;
	};

	m0_tcm_reserved: mcu-tcm@fff84000 {
		reg = <0xfff84000 0x8000>;
		no-map;
	};
};

&mailbox3 {
	rockchip,txdone-irq;
	status = "okay";
};


/**********display**********/
&cma {
	size = <0x200000>;
};

&dsi {
	status = "disabled";
};

&dsi_dphy {
	status = "disabled";
};

&dsi_in_vop {
	status = "disabled";
};

&route_dsi {
	status = "disabled";
};

/**********ethernet**********/
&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins &eth_rmii1_tx_bus2_pins &eth_rmii1_rx_bus2_pins &eth_rmii1_clk_pins>;

	phy-handle = <&rmii_phy1>;
	status = "okay";
};

&mdio1 {
	rmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

/**********usb**********/
&usb20_otg0 {
	dr_mode = "peripheral";
	status = "okay";
};

&usb20_otg1 {
	dr_mode = "host";
	status = "okay";
};
