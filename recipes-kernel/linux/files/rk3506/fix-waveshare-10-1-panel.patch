From: Marcin Bober <mbober1@gmail.com>
Date: Sun, 1 Nov 2026 12:11:42 +0000
Subject: [PATCH] backlight: waveshare-dsi: fix 10.1in panel power-up sequence

Enable the AVDD and IOVCC rails before releasing the panel reset, otherwise
the JD9365 stays unpowered.  While here, use the timing values and burst
mode flags that the panel actually requires.

Upstream-Status: Inappropriate

Signed-off-by: Marcin Bober <mbober1@gmail.com>
---
 drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c  | 11 +++---
 drivers/video/backlight/waveshare-dsi-backlight.c | 41 +++++++++++++++++++++--
 2 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
index 28775f34360c..3011bafaff94 100644
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -2337,12 +2337,13 @@ static const struct drm_display_mode waveshare_10_1_a_mode = {
 	.htotal		= 800 + 40 + 20 + 20,
 
 	.vdisplay	= 1280,
-	.vsync_start	= 1280 + 20,
-	.vsync_end	= 1280 + 20 + 20,
-	.vtotal		= 1280 + 20 + 20 + 4,
+	.vsync_start	= 1280 + 30,
+	.vsync_end	= 1280 + 30 + 4,
+	.vtotal		= 1280 + 30 + 4 + 10,
 
 	.width_mm	= 135,
 	.height_mm	= 216,
+	.flags		= DRM_MODE_FLAG_NVSYNC | DRM_MODE_FLAG_NHSYNC,
 	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
 };
 
@@ -2668,8 +2669,8 @@ static const struct jadard_panel_desc waveshare_10_1_inch_a_desc = {
 	.mode_2ln = &waveshare_10_1_a_mode,
 	.format = MIPI_DSI_FMT_RGB888,
 	.init = waveshare_10_1_a_init,
-	.mode_flags = MIPI_DSI_MODE_VIDEO_HSE | MIPI_DSI_MODE_VIDEO |
-		MIPI_DSI_MODE_LPM | MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	.mode_flags = MIPI_DSI_MODE_VIDEO_BURST | MIPI_DSI_MODE_VIDEO |
+		MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET,
 };
 
 static int waveshare_10_1_b_init(struct jadard *jadard)
diff --git a/drivers/video/backlight/waveshare-dsi-backlight.c b/drivers/video/backlight/waveshare-dsi-backlight.c
index a14920d0eae3..e92527b973de 100644
--- a/drivers/video/backlight/waveshare-dsi-backlight.c
+++ b/drivers/video/backlight/waveshare-dsi-backlight.c
@@ -22,6 +22,9 @@
 #define WS_PWR_VCC		BIT(8)
 #define WS_PWR_VCC_1		BIT(9)
 #define WS_PWR_BL_ENABLE	BIT(2)
+#define WS_PWR_AVDD            BIT(0)
+#define WS_PWR_LCD_RESET       BIT(1)
+#define WS_PWR_IOVCC           BIT(4)
 
 #define WS_BL_MIN_BRIGHTNESS	5
 #define WS_BL_MAX_BRIGHTNESS	255
@@ -61,6 +64,19 @@ static const struct backlight_ops waveshare_dsi_backlight_ops = {
 	.update_status = waveshare_dsi_backlight_update_status,
 };
 
+static int
+waveshare_dsi_backlight_write_state(struct waveshare_dsi_backlight *priv)
+{
+	int ret;
+
+	ret = regmap_write(priv->regmap, REG_TP, priv->poweron_state >> 8);
+	if (ret)
+		return ret;
+
+	return regmap_write(priv->regmap, REG_LCD,
+			    priv->poweron_state & 0xff);
+}
+
 static int waveshare_dsi_backlight_probe(struct i2c_client *client)
 {
 	struct backlight_properties props;
@@ -83,9 +99,28 @@ static int waveshare_dsi_backlight_probe(struct i2c_client *client)
 		return dev_err_probe(&client->dev, PTR_ERR(priv->regmap),
 				     "failed to allocate register map\n");
 
-	priv->poweron_state = WS_PWR_VCC | WS_PWR_VCC_1 | WS_PWR_BL_ENABLE;
-	regmap_write(priv->regmap, REG_TP, priv->poweron_state >> 8);
-	regmap_write(priv->regmap, REG_LCD, priv->poweron_state & 0xff);
+	priv->poweron_state = WS_PWR_VCC | WS_PWR_VCC_1;
+	ret = waveshare_dsi_backlight_write_state(priv);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	priv->poweron_state |= WS_PWR_IOVCC | WS_PWR_AVDD;
+	ret = waveshare_dsi_backlight_write_state(priv);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	priv->poweron_state |= WS_PWR_LCD_RESET;
+	ret = waveshare_dsi_backlight_write_state(priv);
+	if (ret)
+		return ret;
+	msleep(60);
+
+	priv->poweron_state |= WS_PWR_BL_ENABLE;
+	ret = waveshare_dsi_backlight_write_state(priv);
+	if (ret)
+		return ret;
 	usleep_range(20000, 25000);
 
 	if (!regmap_read(priv->regmap, REG_ID, &val))
