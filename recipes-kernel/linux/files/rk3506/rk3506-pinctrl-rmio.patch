From: Marcin Bober <mbober1@gmail.com>
Date: Fri, 30 Oct 2026 22:32:24 +0000
Subject: [PATCH] pinctrl: rockchip: add RK3506 RM_IO support

RK3506 routes many peripherals through RM_IO: the pad iomux selects one of
the RM_IO functions and a per-RM_IO register in GRF_PMU then selects the
actual peripheral signal.  Program the selector register when the mux value
is above 15, encoding the signal as (mux - 15) like the vendor kernel.

Upstream-Status: Inappropriate

Signed-off-by: Marcin Bober <mbober1@gmail.com>
---
 drivers/pinctrl/pinctrl-rockchip.c |   42 ++++++++++++++++++++++++++++++++++++
 drivers/pinctrl/pinctrl-rockchip.h |    1 +
 2 files changed, 43 insertions(+)

diff --git a/drivers/pinctrl/pinctrl-rockchip.c b/drivers/pinctrl/pinctrl-rockchip.c
index ba47b6f323cc..676a399a37da 100644
--- a/drivers/pinctrl/pinctrl-rockchip.c
+++ b/drivers/pinctrl/pinctrl-rockchip.c
@@ -1421,6 +1421,38 @@ static int rockchip_verify_mux(struct rockchip_pin_bank *bank,
 	return 0;
 }
 
+#define RK3506_RMIO_FUNC_OFFSET		15
+#define RK3506_RMIO_IOMUX		7
+#define RK3506_RMIO_SEL_OFFSET		0x80
+
+static int rk3506_set_rmio(struct rockchip_pin_bank *bank, int pin, int func)
+{
+	static const u8 bank1_pins[] = {
+		RK_PB1, RK_PB2, RK_PB3, RK_PC2, RK_PC3, RK_PD1, RK_PD2, RK_PD3,
+	};
+	struct rockchip_pinctrl *info = bank->drvdata;
+	int idx = -1, i;
+
+	if (IS_ERR_OR_NULL(info->regmap_rmio))
+		return -ENODEV;
+
+	if (bank->bank_num == 0 && pin <= RK_PC7) {
+		idx = pin;
+	} else if (bank->bank_num == 1) {
+		for (i = 0; i < ARRAY_SIZE(bank1_pins); i++)
+			if (bank1_pins[i] == pin)
+				idx = 24 + i;
+	}
+
+	if (idx < 0) {
+		dev_err(info->dev, "GPIO%d-%d has no RM_IO\n", bank->bank_num, pin);
+		return -EINVAL;
+	}
+
+	return regmap_write(info->regmap_rmio, RK3506_RMIO_SEL_OFFSET + idx * 4,
+			    (0x7f << 16) | (func & 0x7f));
+}
+
 /*
  * Set a new mux function for a pin.
  *
@@ -1454,6 +1491,13 @@ static int rockchip_set_mux(struct rockchip_pin_bank *bank, int pin, int mux)
 
 	dev_dbg(dev, "setting mux of GPIO%d-%d to %d\n", bank->bank_num, pin, mux);
 
+	if (ctrl->type == RK3506 && mux > RK3506_RMIO_FUNC_OFFSET) {
+		ret = rk3506_set_rmio(bank, pin, mux - RK3506_RMIO_FUNC_OFFSET);
+		if (ret)
+			return ret;
+		mux = RK3506_RMIO_IOMUX;
+	}
+
 	if (bank->iomux[iomux_num].type & IOMUX_SOURCE_PMU)
 		regmap = info->regmap_pmu;
 	else if (bank->iomux[iomux_num].type & IOMUX_L_SOURCE_PMU)
@@ -4824,6 +4868,9 @@ static int rockchip_pinctrl_probe(struct platform_device *pdev)
 	/* try to find the optional reference to the ioc1 syscon */
 	info->regmap_ioc1 = syscon_regmap_lookup_by_phandle_optional(np, "rockchip,ioc1");
 
+	if (ctrl->type == RK3506)
+		info->regmap_rmio = syscon_regmap_lookup_by_compatible("rockchip,rk3506-grf-pmu");
+
 	if (ctrl->type == RK3308) {
 		ret = rk3308_soc_data_init(info);
 		if (ret)
diff --git a/drivers/pinctrl/pinctrl-rockchip.h b/drivers/pinctrl/pinctrl-rockchip.h
index 950097699643..17e363ac5805 100644
--- a/drivers/pinctrl/pinctrl-rockchip.h
+++ b/drivers/pinctrl/pinctrl-rockchip.h
@@ -468,6 +468,7 @@ struct rockchip_pinctrl {
 	struct regmap			*regmap_pull;
 	struct regmap			*regmap_pmu;
 	struct regmap			*regmap_ioc1;
+	struct regmap			*regmap_rmio;
 	struct device			*dev;
 	struct rockchip_pin_ctrl	*ctrl;
 	struct pinctrl_desc		pctl;
