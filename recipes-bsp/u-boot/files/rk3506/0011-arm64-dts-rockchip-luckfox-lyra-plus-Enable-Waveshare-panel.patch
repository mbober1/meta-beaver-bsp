 };
 
+&vop {
+	status = "okay";
+};
+
+&dsi_dphy {
+	status = "okay";
+};
+
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&rm_io0_pins &rm_io1_pins>;
+	status = "okay";
+
+	ws_bl: backlight@45 {
+		compatible = "waveshare,dsi-backlight";
+		reg = <0x45>;
+		default-brightness-level = <200>;
+	};
+};
