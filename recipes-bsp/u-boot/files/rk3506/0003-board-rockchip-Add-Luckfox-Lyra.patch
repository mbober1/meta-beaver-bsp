@@ -0,0 +1,8 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3506-u-boot.dtsi"
+
+&saradc {
+	bootph-pre-ram;
+	vdd-microvolts = <1800000>;
+};
diff --git a/arch/arm/dts/rk3506-luckfox-lyra.dts b/arch/arm/dts/rk3506-luckfox-lyra.dts
new file mode 100644
