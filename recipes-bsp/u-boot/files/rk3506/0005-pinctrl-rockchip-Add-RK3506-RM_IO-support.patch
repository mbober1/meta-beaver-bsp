From e0c4a40f78aad2e438887dd2c6188fbaa145df57 Mon Sep 17 00:00:00 2001
From: Marcin Bober <mbober1@gmail.com>
Date: Thu, 5 Nov 2026 17:46:25 +0000
Subject: [PATCH] pinctrl: rockchip: add RK3506 RM_IO support

RK3506 routes many peripherals through RM_IO: the pad iomux selects one of
the RM_IO functions and a per-RM_IO register in GRF_PMU then selects the
actual peripheral signal.  Decode the extra "rockchip,rmio-grf" phandle and
program the selector register when the mux value is above 15.

Upstream-Status: Pending

Signed-off-by: Marcin Bober <mbober1@gmail.com>
---
 arch/arm/dts/rk3506.dtsi                         | 1 +
 drivers/pinctrl/rockchip/pinctrl-rk3506.c        |   48 ++++++++++++++++++++++
 drivers/pinctrl/rockchip/pinctrl-rockchip-core.c |    9 ++++
 drivers/pinctrl/rockchip/pinctrl-rockchip.h      | 1 +
 4 files changed, 58 insertions(+), 1 deletion(-)

diff --git a/arch/arm/dts/rk3506.dtsi b/arch/arm/dts/rk3506.dtsi
index c2641f9a..075b9cf9 100644
--- a/arch/arm/dts/rk3506.dtsi
+++ b/arch/arm/dts/rk3506.dtsi
@@ -76,6 +76,7 @@
 		rockchip,grf = <&ioc_grf>;
 		rockchip,ioc1 = <&ioc1>;
 		rockchip,pmu = <&ioc_pmu>;
+		rockchip,rmio-grf = <&grf_pmu>;
 		#address-cells = <1>;
 		#size-cells = <1>;
 		ranges;
diff --git a/drivers/pinctrl/rockchip/pinctrl-rk3506.c b/drivers/pinctrl/rockchip/pinctrl-rk3506.c
index 969acb66..1f751c9a 100644
--- a/drivers/pinctrl/rockchip/pinctrl-rk3506.c
+++ b/drivers/pinctrl/rockchip/pinctrl-rk3506.c
@@ -8,18 +8,64 @@
 #include <regmap.h>
 #include <syscon.h>
 
+#include <linux/err.h>
+#include <linux/kernel.h>
+
 #include "pinctrl-rockchip.h"
 #include <dt-bindings/pinctrl/rockchip.h>
 
+#define RK3506_RMIO_FUNC_OFFSET		15
+#define RK3506_RMIO_IOMUX		7
+#define RK3506_RMIO_SEL_OFFSET		0x80
+
+static int rk3506_set_rmio(struct rockchip_pin_bank *bank, int pin, int func)
+{
+	static const u8 bank1_pins[] = {
+		RK_PB1, RK_PB2, RK_PB3, RK_PC2, RK_PC3, RK_PD1, RK_PD2, RK_PD3,
+	};
+	struct rockchip_pinctrl_priv *priv = bank->priv;
+	int idx = -1, i;
+
+	if (IS_ERR_OR_NULL(priv->regmap_rmio))
+		return -ENODEV;
+
+	if (bank->bank_num == 0 && pin <= RK_PC7) {
+		idx = pin;
+	} else if (bank->bank_num == 1) {
+		for (i = 0; i < ARRAY_SIZE(bank1_pins); i++) {
+			if (bank1_pins[i] == pin) {
+				idx = 24 + i;
+				break;
+			}
+		}
+	}
+
+	if (idx < 0) {
+		debug("GPIO%d-%d has no RM_IO\n", bank->bank_num, pin);
+		return -EINVAL;
+	}
+
+	return regmap_write(priv->regmap_rmio,
+			    RK3506_RMIO_SEL_OFFSET + idx * 4,
+			    (0x7f << 16) | (func & 0x7f));
+}
+
 static int rk3506_set_mux(struct rockchip_pin_bank *bank, int pin, int mux)
 {
 	struct rockchip_pinctrl_priv *priv = bank->priv;
 	int iomux_num = (pin / 8);
 	struct regmap *regmap;
-	int reg, mask;
+	int reg, mask, ret;
 	u8 bit;
 	u32 data, rmask;
 
+	if (mux > RK3506_RMIO_FUNC_OFFSET) {
+		ret = rk3506_set_rmio(bank, pin, mux - RK3506_RMIO_FUNC_OFFSET);
+		if (ret)
+			return ret;
+		mux = RK3506_RMIO_IOMUX;
+	}
+
 	if (bank->iomux[iomux_num].type & IOMUX_SOURCE_PMU)
 		regmap = priv->regmap_pmu;
 	else
diff --git a/drivers/pinctrl/rockchip/pinctrl-rockchip-core.c b/drivers/pinctrl/rockchip/pinctrl-rockchip-core.c
index 957dcb52..9c07dfa2 100644
--- a/drivers/pinctrl/rockchip/pinctrl-rockchip-core.c
+++ b/drivers/pinctrl/rockchip/pinctrl-rockchip-core.c
@@ -668,6 +668,15 @@ int rockchip_pinctrl_probe(struct udevice *dev)
 		}
 	}
 
+	if (dev_read_bool(dev, "rockchip,rmio-grf")) {
+		priv->regmap_rmio =
+			syscon_regmap_lookup_by_phandle(dev, "rockchip,rmio-grf");
+		if (IS_ERR(priv->regmap_rmio)) {
+			debug("unable to find rockchip,rmio-grf regmap\n");
+			return PTR_ERR(priv->regmap_rmio);
+		}
+	}
+
 	ctrl = rockchip_pinctrl_get_soc_data(dev);
 	if (!ctrl) {
 		debug("driver data not available\n");
diff --git a/drivers/pinctrl/rockchip/pinctrl-rockchip.h b/drivers/pinctrl/rockchip/pinctrl-rockchip.h
index 568e6024..00d6df83 100644
--- a/drivers/pinctrl/rockchip/pinctrl-rockchip.h
+++ b/drivers/pinctrl/rockchip/pinctrl-rockchip.h
@@ -529,6 +529,7 @@ struct rockchip_pinctrl_priv {
 	struct regmap			*regmap_base;
 	struct regmap			*regmap_pmu;
 	struct regmap			*regmap_ioc1;
+	struct regmap			*regmap_rmio;
 };
 
 extern const struct pinctrl_ops rockchip_pinctrl_ops;
