From 18cf71d3185cd01e7facde02393a66046f741d04 Mon Sep 17 00:00:00 2001
From: Marcin Bober <mbober1@gmail.com>
Date: Wed, 4 Nov 2026 20:37:28 +0000
Subject: [PATCH] video: simple-panel: add Waveshare 10.1in DSI panel

Add the platform data for the Waveshare 10.1in 800x1280 JD9365 panel.  The
RK3506 DSI host only drives it correctly in video burst mode; the DCS init
sequence comes from the panel node in the device tree.

Upstream-Status: Pending

Signed-off-by: Marcin Bober <mbober1@gmail.com>
---
 drivers/video/simple_panel.c |   18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/video/simple_panel.c b/drivers/video/simple_panel.c
index a825e4eb..959036ce 100644
--- a/drivers/video/simple_panel.c
+++ b/drivers/video/simple_panel.c
@@ -240,6 +240,22 @@ static const struct simple_panel_drv_data tfc_s9700rtwv43tr_01b_data = {
 	.num_modes = 1,
 };
 
+/*
+ * Waveshare 10.1" 800x1280 JD9365 based MIPI-DSI panel.  The RK3506 DSI host
+ * only drives this panel correctly in burst mode.  Display timings and the
+ * DCS init sequence come from the panel node in the device tree.
+ */
+static const struct mipi_dsi_panel_plat waveshare_10_1_dsi_plat = {
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET,
+	.format = MIPI_DSI_FMT_RGB888,
+	.lanes = 2,
+};
+
+static const struct simple_panel_drv_data waveshare_10_1_dsi_data = {
+	.mipi_dsi = &waveshare_10_1_dsi_plat,
+};
+
 static const struct udevice_id simple_panel_ids[] = {
 	{ .compatible = "simple-panel" },
 	{ .compatible = "panel-lvds" },
@@ -254,6 +270,8 @@ static const struct udevice_id simple_panel_ids[] = {
 	  .data = (ulong)&panasonic_vvx10f004b00_data },
 	{ .compatible = "tfc,s9700rtwv43tr-01b",
 	  .data = (ulong)&tfc_s9700rtwv43tr_01b_data },
+	{ .compatible = "waveshare,10.1-dsi-touch-a",
+	  .data = (ulong)&waveshare_10_1_dsi_data },
 	{ .compatible = "rocktech,rk043fn48h" },
 	{ }
 };
