From 06f494e780544f5dae17655134b44d6cda5de2bf Mon Sep 17 00:00:00 2001
From: Marcin Bober <mbober1@gmail.com>
Date: Wed, 4 Nov 2026 20:37:28 +0000
Subject: [PATCH] video: rockchip: add RK3506 VOP-lite and MIPI DSI support

The RK3506 has a cut-down VOP (VOP-lite) with a single DPI output wired to
a DesignWare MIPI DSI host and an INNO D-PHY.  Add a display controller
driver for the VOP, a DSI host driver for the RK3506 glue, and the SoC
specific handling in the DesignWare DSI and INNO D-PHY drivers.

Upstream-Status: Pending

Signed-off-by: Marcin Bober <mbober1@gmail.com>
---
 drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c |   51 +++-
 drivers/video/rockchip/Kconfig                   |    9 +
 drivers/video/rockchip/Makefile                  | 1 +
 drivers/video/rockchip/dw_mipi_dsi_rockchip.c    |  109 +++++++-
 drivers/video/rockchip/rk3506_mipi.c             |  134 +++++++++
 drivers/video/rockchip/rk3506_vop.c              |  313 ++++++++++++++++++++++
 6 files changed, 605 insertions(+), 12 deletions(-)
 create mode 100644 drivers/video/rockchip/rk3506_mipi.c
 create mode 100644 drivers/video/rockchip/rk3506_vop.c

diff --git a/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c b/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
index 9aaca8a5..b190131b 100644
--- a/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
+++ b/drivers/phy/rockchip/phy-rockchip-inno-dsidphy.c
@@ -201,10 +201,16 @@ struct clk_hw {
 	const struct clk_init_data *init;
 };
 
+#define RK3506_PRE_EMPHASIS_LANE_EN_MASK	GENMASK(6, 5)
+#define RK3506_PRE_EMPHASIS_LANE_EN		GENMASK(6, 5)
+#define RK3506_PRE_EMPHASIS_RANGE_MASK		GENMASK(7, 6)
+#define RK3506_PRE_EMPHASIS_RANGE_MID		0x1
+
 struct inno_video_phy_plat_data {
 	const struct inno_mipi_dphy_timing *inno_mipi_dphy_timing_table;
 	const unsigned int num_timings;
 	enum phy_max_rate max_rate;
+	bool rk3506_pre_emphasis;
 };
 
 struct inno_dsidphy {
@@ -384,6 +391,7 @@ static void inno_dsidphy_mipi_mode_enable(struct inno_dsidphy *inno)
 	u32 txbyteclkhs, txclkesc, esc_clk_div;
 	u32 hs_exit, clk_post, clk_pre, wakeup, lpx, ta_go, ta_sure, ta_wait;
 	u32 hs_prepare, hs_trail, hs_zero, clk_lane_hs_zero, data_lane_hs_zero;
+	u32 val;
 	unsigned int i;
 
 	timings = inno->pdata->inno_mipi_dphy_timing_table;
@@ -407,6 +415,20 @@ static void inno_dsidphy_mipi_mode_enable(struct inno_dsidphy *inno)
 				CLOCK_LANE_VOD_RANGE_SET_MASK,
 				CLOCK_LANE_VOD_RANGE_SET(VOD_MAX_RANGE));
 	}
+	if (inno->pdata->rk3506_pre_emphasis) {
+		phy_update_bits(inno, REGISTER_PART_ANALOG, 0x18,
+				RK3506_PRE_EMPHASIS_LANE_EN_MASK,
+				RK3506_PRE_EMPHASIS_LANE_EN);
+		phy_update_bits(inno, REGISTER_PART_ANALOG, 0x19,
+				RK3506_PRE_EMPHASIS_RANGE_MASK,
+				RK3506_PRE_EMPHASIS_RANGE_MID << 6);
+		phy_update_bits(inno, REGISTER_PART_ANALOG, 0x1a,
+				RK3506_PRE_EMPHASIS_RANGE_MASK,
+				RK3506_PRE_EMPHASIS_RANGE_MID << 6);
+		phy_update_bits(inno, REGISTER_PART_ANALOG, 0x1b,
+				RK3506_PRE_EMPHASIS_RANGE_MASK,
+				RK3506_PRE_EMPHASIS_RANGE_MID << 6);
+	}
 	/* Enable PLL and LDO */
 	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x01,
 			REG_LDOPD_MASK | REG_PLLPD_MASK,
@@ -532,10 +559,24 @@ static void inno_dsidphy_mipi_mode_enable(struct inno_dsidphy *inno)
 				T_TA_WAIT_CNT(ta_wait));
 	}
 
-	/* Enable all lanes on analog part */
+	switch (inno->dphy_cfg.lanes) {
+	case 1:
+		val = LANE_EN_0;
+		break;
+	case 2:
+		val = LANE_EN_0 | LANE_EN_1;
+		break;
+	case 3:
+		val = LANE_EN_0 | LANE_EN_1 | LANE_EN_2;
+		break;
+	case 4:
+	default:
+		val = LANE_EN_0 | LANE_EN_1 | LANE_EN_2 | LANE_EN_3;
+		break;
+	}
+
 	phy_update_bits(inno, REGISTER_PART_ANALOG, 0x00,
-			LANE_EN_MASK, LANE_EN_CK | LANE_EN_3 | LANE_EN_2 |
-			LANE_EN_1 | LANE_EN_0);
+			LANE_EN_MASK, LANE_EN_CK | val);
 }
 
 static int inno_dsidphy_power_on(struct phy *phy)
@@ -617,6 +664,13 @@ static const struct inno_video_phy_plat_data max_2_5ghz_video_phy_plat_data = {
 	.max_rate = MAX_2_5GHZ,
 };
 
+static const struct inno_video_phy_plat_data rk3506_video_phy_plat_data = {
+	.inno_mipi_dphy_timing_table = inno_mipi_dphy_timing_table_max_2_5ghz,
+	.num_timings = ARRAY_SIZE(inno_mipi_dphy_timing_table_max_2_5ghz),
+	.max_rate = MAX_2_5GHZ,
+	.rk3506_pre_emphasis = true,
+};
+
 static int inno_dsidphy_probe(struct udevice *dev)
 {
 	struct inno_dsidphy *inno = dev_get_priv(dev);
@@ -663,6 +717,9 @@ static const struct udevice_id inno_dsidphy_of_match[] = {
 	}, {
 		.compatible = "rockchip,rk3368-dsi-dphy",
 		.data = (long)&max_1ghz_video_phy_plat_data,
+	}, {
+		.compatible = "rockchip,rk3506-dsi-dphy",
+		.data = (long)&rk3506_video_phy_plat_data,
 	}, {
 		.compatible = "rockchip,rk3568-dsi-dphy",
 		.data = (long)&max_2_5ghz_video_phy_plat_data,
diff --git a/drivers/video/rockchip/Kconfig b/drivers/video/rockchip/Kconfig
index 41d249cb..1a58710c 100644
--- a/drivers/video/rockchip/Kconfig
+++ b/drivers/video/rockchip/Kconfig
@@ -78,4 +78,13 @@ config DISPLAY_ROCKCHIP_DW_MIPI
 	  Select the Designware MIPI DSI controller in use on some Rockchip
 	  SOCs.
 
+config VIDEO_ROCKCHIP_RK3506
+	bool "Rockchip RK3506 VOP-lite and MIPI DSI"
+	depends on VIDEO_ROCKCHIP
+	select DISPLAY_ROCKCHIP_DW_MIPI
+	help
+	  Support the RK3506 VOP-lite display controller and its MIPI DSI
+	  output.  The RK3506 VOP has a single window and cannot use the
+	  rk3288 register map, so it has its own small driver.
+
 endif
