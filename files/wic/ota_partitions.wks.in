#
# short-description: Create an A/B (OTA capable) disk image for Rockchip boards
# long-description: Creates a GPT partitioned image with two rootfs slots so that
# Disk layout
# See: https://opensource.rock-chips.com/wiki_Partitions
#
#   Partition   Start Sector    Number of Sectors
#   loader1     64              7104        (idbloader / U-Boot SPL)
#   loader2     16384           8192        (U-Boot proper)
#   rootfsA     32768           -           (active slot)
#   rootfsB     -               -           (update slot)
#   swap        -               -           (swap, OTA_SWAP_SIZE)
#   data        -               -           (persistent /data, overlayfs upper)

part loader1   --offset 64s    --fixed-size 3552K --fstype=none --part-name loader1   --source rawcopy --sourceparams="file=${SPL_BINARY}"
part loader2   --offset 16384s --fixed-size 4096K --fstype=none --part-name loader2   --source rawcopy --sourceparams="file=u-boot.${UBOOT_SUFFIX}"
part /         --label rootfsA --active           --fstype=ext4 --part-name rootfsA   --source rootfs  --part-type ${ROOT_DPS} --size=${OTA_ROOTFS_SIZE}
part /         --label rootfsB                    --fstype=ext4 --part-name rootfsB   --source rootfs  --part-type ${ROOT_DPS} --size=${OTA_ROOTFS_SIZE}
part swap      --label swap    --ondisk mmcblk0   --fstype=swap --part-name swap    --part-type ${SWAP_DPS}                    --size=${OTA_SWAP_SIZE}
part /data     --label data    --ondisk mmcblk0   --fstype=ext4 --part-name data --use-label                                   --size=${OTA_DATA_SIZE}

bootloader --ptable gpt
